{
  "expo": {
    "name": "Подворье",
    "slug": "podvorie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D5A27"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D5A27"
      },
      "package": "com.farmer.orders"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению необходим доступ к вашей галерее для прикрепления фото товаров.",
          "cameraPermission": "Приложению необходим доступ к камере для съемки фото товаров."
        }
      ]
    ]
  }
}
